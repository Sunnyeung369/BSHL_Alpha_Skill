{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Log Schema",
  "description": "BSHL Alpha Skill - Review Log 复盘日志结构化数据定义",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "复盘唯一标识",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ticker": {
      "type": "string",
      "description": "标的代码",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "trade_completed",
        "observation_ended",
        "judgment_error",
        "rule_validation"
      ],
      "description": "复盘类型"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "description": "复盘日期",
      "minLength": 1,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "original_analysis": {
      "type": "object",
      "properties": {
        "analysis_date": {
          "type": "string",
          "format": "date",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "price_at_analysis": {
          "type": "number"
        },
        "conclusion": {
          "type": "string",
          "enum": [
            "Research Only",
            "Watchlist",
            "Trade Ready",
            "Wait Pullback",
            "Avoid",
            "Veto"
          ]
        },
        "alpha_thesis_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "market_pricing_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "trade_readiness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "core_hypothesis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "market_regime": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "technical_structure": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "risk_governor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stop_loss": {
          "type": "number"
        },
        "target": {
          "type": "number"
        }
      }
    },
    "actual_outcome": {
      "type": "object",
      "properties": {
        "price_at_review": {
          "type": "number"
        },
        "price_change_percent": {
          "type": "number"
        },
        "price_path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "minLength": 1,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "price": {
                "type": "number"
              },
              "event": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "catalyst_realization": {
          "type": "object",
          "properties": {
            "catalyst": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "realized": {
              "type": "string",
              "enum": [
                "realized",
                "partial",
                "not_realized"
              ]
            },
            "impact": {
              "type": "string",
              "enum": [
                "positive",
                "neutral",
                "negative"
              ]
            }
          }
        },
        "market_changes": {
          "type": "object",
          "properties": {
            "index_change": {
              "type": "number"
            },
            "sector_change": {
              "type": "number"
            },
            "risk_appetite_change": {
              "type": "string",
              "enum": [
                "improved",
                "stable",
                "deteriorated"
              ]
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "properties": {
        "correct_aspects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "aspect": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "incorrect_aspects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "aspect": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "evidence_validation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "validated": {
                "type": "string",
                "enum": [
                  "validated",
                  "partial",
                  "invalidated"
                ]
              }
            }
          }
        },
        "market_regime_judgment": {
          "type": "object",
          "properties": {
            "correct": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "incorrect": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "technical_judgment": {
          "type": "object",
          "properties": {
            "correct": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "incorrect": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "early_warning": {
              "type": "boolean",
              "description": "K线是否提前预警"
            }
          }
        },
        "risk_control_execution": {
          "type": "object",
          "properties": {
            "stop_executed": {
              "type": "boolean"
            },
            "position_size_appropriate": {
              "type": "boolean"
            },
            "effectiveness": {
              "type": "string",
              "enum": [
                "effective",
                "partial",
                "ineffective"
              ]
            }
          }
        }
      }
    },
    "root_cause_analysis": {
      "type": "object",
      "properties": {
        "success_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "failure_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "system_biases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bias": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "impact": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        }
      }
    },
    "rule_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_type": {
            "type": "string",
            "enum": [
              "new",
              "modified",
              "deleted"
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "lessons_learned": {
      "type": "object",
      "properties": {
        "reusable_insights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "mistakes_to_avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "improvements_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "follow_up_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ]
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "更新时间",
      "minLength": 1
    },
    "schema_version": {
      "const": "0.6"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "live",
        "csv",
        "mock",
        "unavailable"
      ]
    },
    "is_mock": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "ticker",
    "review_type",
    "review_date",
    "original_analysis",
    "actual_outcome"
  ]
}
