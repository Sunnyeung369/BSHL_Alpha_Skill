{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alpha Thesis Schema",
  "description": "BSHL Alpha Skill - Alpha Thesis 投研假设结构化数据定义",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string",
      "description": "标的代码"
    },
    "name": {
      "type": "string",
      "description": "标的名称"
    },
    "asset_class": {
      "type": "string",
      "enum": ["US_STOCK", "HK_STOCK", "CN_STOCK", "ETF", "CRYPTO", "TOKEN"],
      "description": "资产类别"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "分析日期"
    },
    "core_hypothesis": {
      "type": "string",
      "description": "核心假设"
    },
    "supply_chain_position": {
      "type": "string",
      "description": "产业链位置"
    },
    "demand_driver": {
      "type": "string",
      "description": "需求驱动"
    },
    "supply_constraint": {
      "type": "string",
      "description": "供给约束"
    },
    "benefit_path": {
      "type": "string",
      "description": "公司受益路径"
    },
    "catalyst": {
      "type": "string",
      "description": "催化剂"
    },
    "time_window": {
      "type": "string",
      "description": "时间窗口"
    },
    "valuation_mismatch": {
      "type": "string",
      "description": "估值错配"
    },
    "max_risk": {
      "type": "string",
      "description": "最大风险"
    },
    "conclusion_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "结论等级"
    },
    "alpha_thesis_score": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "demand_inflection": {"type": "number"},
            "supply_chain_bottleneck": {"type": "number"},
            "company_benefit_certainty": {"type": "number"},
            "evidence_quality": {"type": "number"},
            "catalyst_timing": {"type": "number"},
            "valuation_mismatch": {"type": "number"},
            "competition": {"type": "number"},
            "contradiction_clarity": {"type": "number"}
          }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "source_type": {
            "type": "string",
            "enum": ["filing", "transcript", "company_release", "industry_report", "media", "social"]
          },
          "source_date": {"type": "string"},
          "evidence_strength": {
            "type": "string",
            "enum": ["strong", "medium", "weak", "stale"]
          },
          "supports_or_refutes": {
            "type": "string",
            "enum": ["supports", "refutes", "mixed"]
          },
          "affected_thesis": {
            "type": "string",
            "enum": ["demand", "supply", "margin", "valuation", "catalyst", "risk"]
          },
          "freshness": {
            "type": "string",
            "enum": ["fresh", "aging", "stale"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "kill_switch": {"type": "boolean"}
        }
      }
    },
    "contradiction_matrix": {
      "type": "object",
      "properties": {
        "max_contradiction": {"type": "string"},
        "alternative_explanation": {"type": "string"},
        "kill_switch_evidence": {"type": "string"},
        "pending_questions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Research Only", "Watchlist", "Trade Ready", "Wait Pullback", "Avoid", "Veto"]
    }
  },
  "required": ["ticker", "name", "asset_class", "date", "core_hypothesis", "status"]
}
